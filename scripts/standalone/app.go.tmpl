// App is the single binding object: the page talks to window.go.main.App.*.
type App struct {
	ctx  context.Context
	data string
	svc  *crushfling.Service
}

// NewApp wires the dashboard to the crushfling service.
func NewApp(dataDir string, svc *crushfling.Service) *App {
	return &App{data: dataDir, svc: svc}
}

func (a *App) startup(ctx context.Context) { a.ctx = ctx }

// shutdown must never leave a Chromium window behind when the app closes.
func (a *App) shutdown(context.Context) {
	if a.svc != nil {
		_ = a.svc.StopBulk()
	}
	crushfling.CloseAllBrowsers()
}

// --- run control ----------------------------------------------------------

// StartBulk starts a registration run with the dashboard settings.
func (a *App) StartBulk(cfg crushfling.RegisterConfig) error {
	if a.svc == nil {
		return fmt.Errorf("crushfling service not initialized")
	}
	return a.svc.StartBulk(cfg)
}

// StopBulk cancels the run and closes every browser the worker opened.
func (a *App) StopBulk() error {
	if a.svc == nil {
		return fmt.Errorf("crushfling service not initialized")
	}
	return a.svc.StopBulk()
}

