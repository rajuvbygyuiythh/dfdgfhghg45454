// --- folders, logs, diagnostics ------------------------------------------

// GetCrushSummary is the single call the dashboard polls for its header.
func (a *App) GetCrushSummary() CrushSummary {
	summary := CrushSummary{Browsers: crushfling.OpenBrowserCount()}
	if a.svc == nil {
		return summary
	}
	summary.DataDir = a.svc.DataDir()
	summary.Stats = a.svc.GetStats()
	summary.Running = summary.Stats.Running
	if n, err := a.svc.GetPictureCount(); err == nil {
		summary.Pictures = n
	}
	if info, err := a.svc.GetBioInfo(); err == nil {
		summary.Bios = info.Remaining
		summary.BioFile = info.Path
	}
	if accounts, err := a.svc.ListAccounts(); err == nil {
		summary.Accounts = len(accounts)
		for _, account := range accounts {
			if account.Verified {
				summary.Verified++
			}
		}
	}
	summary.PictureDir = a.picturesDir()
	summary.AccountsCSV = filepath.Join(a.svc.DataDir(), "accounts.csv")
	return summary
}

// CrushSummary is what the dashboard header polls.
type CrushSummary struct {
	Running     bool                         `json:"running"`
	Pictures    int                          `json:"pictures"`
	Bios        int                          `json:"bios"`
	Accounts    int                          `json:"accounts"`
	Verified    int                          `json:"verified"`
	Browsers    int                          `json:"browsers"`
	BioFile     string                       `json:"bio_file"`
	PictureDir  string                       `json:"picture_dir"`
	DataDir     string                       `json:"data_dir"`
	AccountsCSV string                       `json:"accounts_csv"`
	Stats       crushfling.RegistrationStats `json:"stats"`
}

