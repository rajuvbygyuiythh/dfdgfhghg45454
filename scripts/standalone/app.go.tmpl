// PickCrushPictureFolder opens the native folder dialog.
func (a *App) PickCrushPictureFolder() (string, error) {
	dir, err := wailsruntime.OpenDirectoryDialog(a.ctx, wailsruntime.OpenDialogOptions{
		Title:            "Select the folder with profile pictures",
		DefaultDirectory: a.picturesDir(),
	})
	if err != nil {
		return "", err
	}
	return dir, nil
}

// OpenCrushPicturesFolder opens the picture folder in Explorer.
func (a *App) OpenCrushPicturesFolder() (string, error) {
	dir := a.picturesDir()
	if err := os.MkdirAll(dir, 0o755); err != nil {
		return "", err
	}
	if err := openPathInOS(dir); err != nil {
		return "Pictures: " + dir, err
	}
	return "Pictures: " + dir, nil
}

